# AgentGuard environment configuration template
# Copy to .env and fill in values if needed.
# The base application works without any values here.

# Optional: Override the SQLite database path
# AGENTGUARD_DB_PATH=./agentguard.db

# Optional: Override the API host/port (default: localhost:8000)
# AGENTGUARD_API_HOST=localhost
# AGENTGUARD_API_PORT=8000
